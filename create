#!/bin/bash
set -e

PATH=$(dirname "$0")/bin:$PATH
source color

(($EUID)) && fail "Must be root"

cage=./cage
apt=$cage/etc/apt

export ARCH=${ARCH:-$(dpkg-architecture -q DEB_BUILD_ARCH)}
export DIST=${DIST:-resolute}

stop $cage
purge $cage
echo

bootstrap $cage
echo

if [[ "$DIST" == "pika" ]]; then
    cyan "Adding PikaOS sources"
    rm -r $apt/{sources.list,trusted.gpg.d}
    cp -v apt/sources.list.d/50-pika.sources $apt/sources.list.d/
    cp -v apt/keyrings/pika-keyring.gpg $apt/keyrings/
    cp -v apt/preferences.d/50-pika $apt/preferences.d/
    echo

elif [[ "$DIST" == "unstable" || "$DIST" == "sid" ]]; then
    cyan "Updating Debian sources"
    rm -r $apt/{sources.list,trusted.gpg.d}
    cp -v apt/sources.list.d/50-debian-sid.sources $apt/sources.list.d/
    echo

elif debian-distro-info --all | grep -qx "$DIST"; then
    cyan "Updating Debian sources"
    rm -r $apt/{sources.list,trusted.gpg.d}
    cp -v apt/sources.list.d/50-debian.sources $apt/sources.list.d/
    sed -ri -e "s/%distro%/$DIST/g; s/%arch%/$ARCH/g" $apt/sources.list.d/50-debian.sources
    echo

elif ubuntu-distro-info --all | grep -qx "$DIST"; then
    cyan "Updating Ubuntu sources"
    rm -r $apt/{sources.list,trusted.gpg.d}
    cp -v apt/sources.list.d/50-ubuntu.sources $apt/sources.list.d/
    sed -ri -e "s/%distro%/$DIST/g; s/%arch%/$ARCH/g" $apt/sources.list.d/50-ubuntu.sources

    url=http://ports.ubuntu.com/ubuntu-ports
    [[ "$ARCH" == "i386" || "$ARCH" == "amd64" ]] || sed -ri -e "s|URIs: .*|URIs: $url|" $apt/sources.list.d/50-ubuntu.sources
    echo
fi

spawn $cage
echo

cyan "Starting stage3"
cp -v $(dirname "$0")/bin/stage3 $cage/root/
cp -v $(dirname "$0")/deb/*.deb $cage/root/
shell $cage /root/stage3 "$DIST" "$@"
echo

stop $cage
