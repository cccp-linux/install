#!/bin/bash
set -e

PATH=$(dirname "$0")/bin:$PATH
source color

(($EUID)) && fail "Must be root"

cage=./cage
apt=$cage/etc/apt

export ARCH=${ARCH:-$(dpkg-architecture -q DEB_BUILD_ARCH)}
export DIST=${DIST:-resolute}

stop $cage
purge $cage
echo

bootstrap $cage
echo

cyan "Updating Ubuntu sources"
rm -r $apt/{sources.list,trusted.gpg.d}
cp apt/sources.list.d/50-ubuntu.sources $apt/sources.list.d/
sed -ri -e "s/%distro%/$DIST/g; s/%arch%/$ARCH/g" $apt/sources.list.d/50-ubuntu.sources

url=http://ports.ubuntu.com/ubuntu-ports
[[ "$ARCH" == "i386" || "$ARCH" == "amd64" ]] || sed -ri -e "s|URIs: .*|URIs: $url|" $apt/sources.list.d/50-ubuntu.sources

cyan "Adding CCCP sources"
cp apt/sources.list.d/30-cccp-linux-main.sources $apt/sources.list.d/
cp apt/keyrings/cccp-linux-keyring.gpg $apt/keyrings/
sed -ri -e "s/%distro%/$DIST/g; s/%arch%/$ARCH/g" $apt/sources.list.d/30-cccp-linux-main.sources
echo

spawn $cage
echo

cyan "Starting stage3"
cp -v $(dirname "$0")/bin/stage3 $cage/root/
shell $cage /root/stage3 "$@"
echo

stop $cage
