#!/bin/bash
set -e

cyan() { tput setaf 6; echo "$@"; tput sgr0; }
 red() { tput setaf 1; echo "$@"; tput sgr0; }
fail() { red "$@"; exit 1; }

(($EUID)) && fail "Must be root"
(($#< 1)) && fail "Specify username to add"

bin=$(dirname "$0")
cage=cage

cyan "Creating user $1"
$bin/spawn "$cage" /bin/bash -c "
adduser '$1'
for grp in adm audio netdev plugdev render sudo users video; do
    adduser '$1' \$grp || true
done
"
