#!/bin/bash
set -e

source $(dirname "$0")/color
cage=${1:-cage}
name=$(basename "$cage")

ARCH=${ARCH:-$(dpkg-architecture -q DEB_BUILD_ARCH)}
DIST=${DIST:-$(lsb_release -cs)}

cyan -n "Bootstrapping $cage "; echo "$ARCH $DIST"
sleep 3
debootstrap --arch=$ARCH --cache-dir=/var/cache/apt/archives --include=dbus,systemd --variant=minbase $DIST $cage
